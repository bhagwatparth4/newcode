# ============================================================
#  Copy this file to ".env" and fill in real values.
#  NEVER commit the real .env file (it is in .gitignore).
# ============================================================

# ---------- Database (used by docker-compose AND the backend) ----------
POSTGRES_DB=cafe_ordering
POSTGRES_USER=cafe_user
POSTGRES_PASSWORD=changeme
# Optional, only when the database is not on localhost:
# DB_URL=jdbc:postgresql://localhost:5432/cafe_ordering

# ---------- Redis (rate limiting) ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- Security ----------
# Must be a long random string: at least 64 characters (HS512).
# Generate one with:  openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-64-characters-xxxxxxxxxxxx

# ---------- Razorpay (client provides these at deployment) ----------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

# ---------- Per-client vendor configuration ----------
# SMALL_CAFE  = Admin dashboard only
# LARGE_CAFE  = Admin + Kitchen dashboards
# RESTAURANT  = Admin + Kitchen dashboards
BUSINESS_TYPE=SMALL_CAFE
CAFE_NAME=Rush Hours
APP_TIMEZONE=Asia/Kolkata
FRONTEND_URL=http://localhost:5173

# ---------- Optional: Web Push (leave empty to disable) ----------
# Generate a key pair once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# ---------- Optional: SMS / WhatsApp marketing (leave empty to disable) ----------
TWOFACTOR_API_KEY=
TWOFACTOR_SMS_HEADER=
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_NAME=

# ---------- Menu & category photos ----------
# local       = saved on this server (development only)
# s3          = AWS S3        (fill the S3_ values)
# cloudinary  = Cloudinary    (fill the CLOUDINARY_ values)
STORAGE_PROVIDER=local
BACKEND_PUBLIC_URL=http://localhost:8080

S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional: CloudFront / custom domain for photos
S3_PUBLIC_BASE_URL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rushhour
