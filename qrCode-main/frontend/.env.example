# Copy to ".env" (local) or ".env.production" (build) and adjust.
# Only PUBLIC values belong here: every VITE_ variable ends up
# inside the website and anyone can read it. Never put secrets here.

# Backend address
VITE_API_URL=http://localhost:8080
# WebSocket address (optional; derived from VITE_API_URL when empty)
VITE_WS_URL=

# Branding for this client
VITE_CAFE_NAME=Rush Hours
VITE_CAFE_TAGLINE=Brews · Bites · Tales
VITE_CAFE_ADDRESS=
VITE_CAFE_PHONE=
